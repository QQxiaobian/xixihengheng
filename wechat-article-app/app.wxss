/* 全局样式 */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  color: #333;
}

.container {
  padding: 24rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
  color: #222;
}

.article-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.article-card .title {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.article-card .summary,
.article-card .abstract {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.article-card .meta {
  font-size: 24rpx;
  color: #999;
}

.cover {
  width: 100%;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

button {
  margin-top: 16rpx;
}
