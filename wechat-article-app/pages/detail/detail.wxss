.article-title {
  font-size: 42rpx;
  font-weight: bold;
  color: #222;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.article-meta {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.content {
  font-size: 30rpx;
  line-height: 1.8;
  color: #444;
}

.abstract {
  color: #666;
  margin-bottom: 32rpx;
}

.lock-box {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 24rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.lock-tip {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 24rpx;
}

.unlock-btn {
  width: 60%;
}
